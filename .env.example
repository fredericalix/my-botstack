# botstack configuration, read by compose.yaml (the bridge's environment, and
# BOTSTACK_DOMAIN for Caddy). scripts/setup.sh copies this file to .env and
# fills the domain and the secrets; .env is gitignored. Never share it.
#
# One VAR=value per line, no inline comments, no quotes.
# A line commented out keeps the bridge's default. Do not leave a numeric
# setting empty: an empty value is not the default.

# --- Where the bridge is reached --------------------------------------------

# The public name of this server. Its DNS must point here, and ports 80 and
# 443 must be open: Caddy gets the certificate from Let's Encrypt.
BOTSTACK_DOMAIN=bot.example.com
# The bridge's public base URL: derived from BOTSTACK_DOMAIN when empty
# (https:// + the domain). The robots upload photos and download updates from
# here. Set it only if they reach the bridge at another address.
PUBLIC_URL=
# Override the two URLs PUBLIC_URL gives, if they live elsewhere.
# PUBLIC_VISION_URL=https://bot.example.com/mcp/vision/explain
# PUBLIC_FIRMWARE_URL=https://bot.example.com/botstack/v1/firmware

# --- Secrets (generated or asked by scripts/setup.sh) -----------------------

# xAI API key (https://console.x.ai): realtime voice, vision, text to speech.
XAI_API_KEY=
# The bootstrap key every new device presents on its first connection;
# firmware/robot-token holds the same value and the firmware embeds it.
# Generated by scripts/setup.sh.
ROBOT_TOKEN=
# The token of the fleet admin MCP (/fleet/mcp, scripts/fleet.sh): approve,
# lock, rename devices. Generated by scripts/setup.sh.
FLEET_ADMIN_TOKEN=
# The token Grok Bot uses on /grok/mcp (optional Grok Bot integration).
# Generated by scripts/setup.sh.
GROK_BRIDGE_TOKEN=
# Where the bridge posts the questions for Grok Bot (an HTTPS webhook), and
# the bearer token it sends there. Leave empty without Grok Bot.
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_TOKEN=

# --- Who the robots talk to --------------------------------------------------

# Your first name, used in the voice instructions. Empty: "the user".
OWNER_NAME=
# IANA timezone for the date in the instructions and the daily minutes.
TIMEZONE=UTC
# Language of new devices (ISO 639-1: en, fr...). Each device can be changed
# later with fleet_set_profile; the robots also switch on request.
DEFAULT_LANGUAGE=en
# What Grok Bot can reach, as the voice describes it.
# GROK_BOT_SCOPE=their accounts, mail, calendar and files
# Words the speech recognition should expect (comma list), e.g. names.
# KEYTERMS=Grok Bot,StackChan

# A device approved from the first start, without fleet_approve, and the one
# Grok Bot speaks to when it names none: its MAC (lowercase) and name.
# GROK_DEVICE_ID=
# GROK_DEVICE_NAME=stackchan

# --- Voice and limits ----------------------------------------------------------

# XAI_VOICE=eve
# XAI_VOICE_MODEL=grok-voice-3.0
# XAI_REASONING=none
# XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
# XAI_VISION_MODEL=grok-4.3
# Conversations at the same time, all devices together.
# MAX_CONVERSATIONS=3
# Seconds of silence before a conversation ends.
# IDLE_CLOSE_SECONDS=40

# --- Inside the container (keep the defaults with compose) --------------------

# BIND=0.0.0.0:8080
# DATA_DIR=/data
# RUST_LOG=info
